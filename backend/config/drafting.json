{
  "_note": "SPANDAN AI drafting configuration (Phase 4). Wording templates only: they contain no facts. Placeholders are filled from the fact-locked DraftFactSet ({location}, {duration}). States are the Phase 2 English issue labels (e.g. 'not working'). Department and jurisdiction are NOT configured here; they come from Phase 3. administrative_vocabulary: neutral words optional AI wording may use in addition to the template wording and the citizen's own words; any other content word in AI wording is treated as a new, unsupported fact (fail closed).",
  "version": "drafting-templates-v1",
  "draft_languages": [
    "en"
  ],
  "limits": {
    "subject_chars": 160,
    "section_chars": 1500,
    "body_chars": 6000,
    "edit_field_chars": 1500
  },
  "duration_phrase": " for approximately {duration}",
  "location_phrase": {
    "citizen_english": "{location}",
    "citizen_other_language": "at the location described by the citizen as “{location}”"
  },
  "templates": {
    "streetlight": {
      "subject": {
        "default": "Complaint regarding streetlight issue",
        "not working": "Complaint regarding non-functional streetlight",
        "damaged": "Complaint regarding damaged streetlight"
      },
      "summary": {
        "default": "A streetlight issue has been reported {location}{duration}.",
        "not working": "A streetlight {location} has reportedly not been functioning{duration}.",
        "damaged": "A streetlight {location} has reportedly been damaged{duration}."
      },
      "issue_label": {
        "not working": "Non-functional streetlight",
        "damaged": "Damaged streetlight",
        "default": "Streetlight issue"
      },
      "requested_action": "Kindly inspect the reported streetlight and take the necessary maintenance action."
    },
