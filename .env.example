# SPANDAN AI environment variables.
# Copy to `.env` in the repository root and fill in values. Never commit `.env`.
# The backend and the frontend both read this one file.

# ---------------------------------------------------------------- backend
# development | test | production  (no key is required; production rejects unsafe settings such as FRONTEND_ORIGIN=* or LOG_LEVEL=DEBUG)
APP_ENV=development
LOG_LEVEL=INFO

# SQLite for the hackathon MVP. Default (if unset): backend/data/agentx.db
# DATABASE_URL=sqlite:///./data/agentx.db

# Comma-separated origins allowed to call the API (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# Citizen intake (Phase 2) is OFFLINE-FIRST: all six languages (en, ta, te, hi, kn, ml)
# are understood with local rules and language resource files. Nothing below is required.

# Optional Gemini API key - server-side only. Used ONLY to fill a required fact the
# offline engine could not find, to translate to English, and to guess the language of
# ambiguous Latin-script text. Every AI fact is still checked against the citizen's words.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20

# Server speech-to-text for uploaded audio: auto | local | whisper | none
#   auto    = local model if installed, then remote Whisper if OPENAI_API_KEY is set
#   local   = faster-whisper model directory in LOCAL_STT_MODEL_PATH (not bundled)
#   whisper = remote OpenAI Whisper (needs OPENAI_API_KEY)
# The browser's own speech recognition works without any of this. Audio is never stored.
SPEECH_TO_TEXT_PROVIDER=auto
LOCAL_STT_MODEL_PATH=
OPENAI_API_KEY=
STT_TIMEOUT_SECONDS=30
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=120

# Civic knowledge base (Phase 3). Local ChromaDB directory; no external vector DB or embedding API.
# KB_VECTOR_DIR=./data/chroma
# hashing (default: offline, deterministic) | onnx-minilm (optional local model; not bundled)
KB_EMBEDDING_PROVIDER=hashing
# Re-ingest automatically when the collection is missing or stale. With false, run
# `python scripts/ingest_civic_kb.py`; classification answers 503 until then.
KB_AUTO_INGEST=true

# Mock Government Grievance API (hackathon simulation, Phase 5).
MOCK_GOV_API_BASE_URL=http://localhost:8001/mock-gov/v1
MOCK_GOV_API_KEY=

# --------------------------------------------------------------- frontend
# Only VITE_* variables reach the browser. Never put a secret in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000
