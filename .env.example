# AGENT X environment variables.
# Copy to `.env` in the repository root and fill in values. Never commit `.env`.
# The backend and the frontend both read this one file.

# ---------------------------------------------------------------- backend
# development | test | production  (production refuses to start without the secrets below)
APP_ENV=development
LOG_LEVEL=INFO

# SQLite for the hackathon MVP. Default (if unset): backend/data/agentx.db
# DATABASE_URL=sqlite:///./data/agentx.db

# Comma-separated origins allowed to call the API (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# Gemini API key - server-side only, used from Phase 2. Leave blank for local Phase 1 work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mock Government Grievance API (hackathon simulation, Phase 5).
MOCK_GOV_API_BASE_URL=http://localhost:8001/mock-gov/v1
MOCK_GOV_API_KEY=

# --------------------------------------------------------------- frontend
# Only VITE_* variables reach the browser. Never put a secret in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000
